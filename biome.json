{
  "files": {
    "includes": ["web/**/*.js", "web/**/*.css", "e2e/*.mjs", "!!**/target", "!!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 130
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "bracketSpacing": false,
      "arrowParentheses": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noImportantStyles": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  }
}
